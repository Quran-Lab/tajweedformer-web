{
 "about": "SDK 2.0.3 back-to-back takes (make_takes_join.py): replay the events per case; the recordings the capture forms, each with its input rate, audio ms (floor of samples * 1000 / rate) and its take metadata (null for a single take).",
 "default_window_ms": 3000,
 "cap_ms": 1200000,
 "cases": [
  {
   "name": "three back-to-back takes: one recording",
   "flags": {},
   "events": [
    {
     "event": "take",
     "start_wall_ms": 0,
     "samples": 80000,
     "rate": 16000,
     "end_wall_ms": 5000
    },
    {
     "event": "take",
     "start_wall_ms": 6200,
     "samples": 48000,
     "rate": 16000,
     "end_wall_ms": 9200
    },
    {
     "event": "take",
     "start_wall_ms": 10000,
     "samples": 64000,
     "rate": 16000,
     "end_wall_ms": 14000
    }
   ],
   "expect": [
    {
     "rate": 16000,
     "audio_ms": 12000,
     "takes": [
      {
       "start_ms": 0,
       "gap_ms": 0
      },
      {
       "start_ms": 5000,
       "gap_ms": 1200
      },
      {
       "start_ms": 8000,
       "gap_ms": 800
      }
     ]
    }
   ]
  },
  {
   "name": "a gap over the window: two recordings",
   "flags": {},
   "events": [
    {
     "event": "take",
     "start_wall_ms": 0,
     "samples": 80000,
     "rate": 16000,
     "end_wall_ms": 5000
    },
    {
     "event": "take",
     "start_wall_ms": 8001,
     "samples": 48000,
     "rate": 16000,
     "end_wall_ms": 11001
    }
   ],
   "expect": [
    {
     "rate": 16000,
     "audio_ms": 5000,
     "takes": null
    },
    {
     "rate": 16000,
     "audio_ms": 3000,
     "takes": null
    }
   ]
  },
  {
   "name": "the window edge: exactly 3000 joins",
   "flags": {},

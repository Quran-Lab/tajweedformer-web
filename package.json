{
  "name": "@quran-lab/tajweedformer",
  "version": "3.1.0",
  "description": "TajweedFormer for browsers and Node, a pure inference SDK: the exact engine in WebAssembly (bit-identical to the native engine, in a Worker in browsers), cached and verified model delivery, every head of the network, the decoded layer (top-1 and runner-up, confidence, timings, speech and silence), one call from microphone to output, and the Quran Lab client (signed config, telemetry, opt-in recitation sharing).",
  "type": "module",
  "main": "web/index.js",
  "types": "web/index.d.ts",
  "exports": {
    ".": {
      "types": "./web/index.d.ts",
      "node": "./web/index.node.js",
      "default": "./web/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "web/",
    "dist/tajweedformer.mjs",
    "dist/tajweedformer.wasm",
    "dist/tajweedformer-opus.mjs",
    "dist/tajweedformer-opus.wasm",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "docs/api.md",
    "docs/migrating-to-3.md",
    "docs/platform-client.md",
    "examples/quickstart.html",
    "examples/node.mjs",
    "examples/vite/index.html",
    "examples/vite/main.js",
    "examples/vite/package.json",
    "examples/vite/.npmrc",
    "examples/vite/README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:all": "bash scripts/build.sh && bash scripts/build_opus.sh",
    "bench": "bash scripts/bench.sh",
    "bench:rt": "node test/pool_bench.mjs",
    "test": "node --max-old-space-size=2048 --expose-gc --test --test-concurrency=3 --test-timeout=300000 \"test/*.test.mjs\"",
    "test:wasm": "node test/smoke.mjs",
    "conformance": "bash scripts/conformance.sh",
    "serve": "node scripts/serve.mjs",
    "build:opus": "bash scripts/build_opus.sh",
    "build:1x": "bash scripts/build.sh --with-1x && bash scripts/build.sh --with-1x --threads 4 && bash scripts/build.sh --with-1x --no-simd",
    "test:browser": "node scripts/browser-quickstart.mjs",
    "proof": "node scripts/proof.mjs",
    "example:build": "node scripts/build-example.mjs",
    "check:package": "node scripts/check-package.mjs",
    "size": "node scripts/size.mjs",
    "gen:errors": "node scripts/gen_errors.mjs"
  },
  "license": "SEE LICENSE IN README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quran-Lab/tajweedformer-web"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  },
  "sideEffects": [
    "./web/consent/*.js"
  ]
}

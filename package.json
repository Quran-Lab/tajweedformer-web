{
  "name": "@quran-lab/tajweedformer",
  "version": "2.0.0",
  "description": "TajweedFormer V4 for browsers and Node: the exact engine in WebAssembly (bit-identical to the native engine), cached and verified model delivery, every head of the network, the decoded layer (top-1 and runner-up, confidence, timings), per-site and per-word tajweed verdicts with calibrated settings, and the Quran Lab platform client (signed config, telemetry, opt-in recitation sharing).",
  "type": "module",
  "main": "web/index.js",
  "types": "web/index.d.ts",
  "exports": {
    ".": {
      "types": "./web/index.d.ts",
      "import": "./web/index.js"
    },
    "./scorer": {
      "types": "./web/scorer.d.ts",
      "import": "./web/scorer.js"
    },
    "./tajweed": {
      "types": "./web/tajweed/index.d.ts",
      "import": "./web/tajweed/index.js"
    },
    "./node": {
      "types": "./web/tajweed/node.d.ts",
      "import": "./web/tajweed/node.js"
    },
    "./platform": {
      "types": "./web/platform/index.d.ts",
      "import": "./web/platform/index.js"
    },
    "./consent": {
      "types": "./web/consent/index.d.ts",
      "import": "./web/consent/index.js"
    },
    "./sharing": {
      "types": "./web/sharing/index.d.ts",
      "import": "./web/sharing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "web/",
    "dist/tajweedformer.mjs",
    "dist/tajweedformer.wasm",
    "dist/tajweedformer-scorer.mjs",
    "dist/tajweedformer-scorer.wasm",
    "dist/tajweedformer-opus.mjs",
    "dist/tajweedformer-opus.wasm",
    "README.md",
    "CHANGELOG.md",
    "docs/api.md",
    "examples/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:scorer": "bash scripts/build_scorer.sh",
    "build:all": "bash scripts/build.sh && bash scripts/build_scorer.sh && bash scripts/build_opus.sh",
    "bench": "bash scripts/bench.sh",
    "bench:rt": "node test/pool_bench.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:wasm": "node test/smoke.mjs",
    "conformance": "bash scripts/conformance.sh",
    "serve": "node scripts/serve.mjs",
    "build:opus": "bash scripts/build_opus.sh",
    "build:1x": "bash scripts/build.sh --with-1x && bash scripts/build.sh --with-1x --threads 4 && bash scripts/build.sh --with-1x --no-simd",
    "test:browser": "node scripts/browser-v4.mjs",
    "size": "node scripts/size.mjs"
  },
  "license": "SEE LICENSE IN README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quran-Lab/tajweedformer-web"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  },
  "sideEffects": [
    "./web/consent/*.js"
  ]
}
